# 复制成 deploy.env 后 chmod 600，只在私有部署使用；不要提交进仓库。
# 自己的星历 CDN（华为云 CDN 也可以），留空则不访问任何 CDN，只走公开 RINEX 自算。
EPHEMERIS_CDN_URL=
# 常驻进程的刷新间隔（秒，最小 60，默认 3600）
EPHEMERIS_REFRESH_SECS=3600

# 下面这些按需填写，和 blog.env 里的博客只读凭据不要混用。
# PUBLIC_BASE_URL=https://sync.example.com
# VITALOOP_BLOG_TOKEN=
# VITALOOP_BLOG_ACCOUNT_ID=
# BLOG_HEALTH_ACCOUNT_ID=
